# ==============================================================================
# IMARA ONE Search — Backend Environment Variables (Fly.io)
# ==============================================================================

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=generate_a_secure_random_64_character_key_for_production

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000
CORS_ORIGINS=["https://imaraone.com","http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60

# Supabase Cloud PostgreSQL Database
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Meilisearch (Optional / Remote Cluster)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=your_meilisearch_key

# Privacy & Security
PRIVACY_DEFAULT_RAW_QUERY_LOGGING=false
PRIVACY_DEFAULT_IP_STORAGE=false
SECURITY_STRICT_SSRF_ENFORCEMENT=true
